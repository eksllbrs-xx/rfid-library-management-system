        private void SubmitButton_Click(
            object? sender,
            EventArgs e)
        {
            string bookTitle =
                bookTitleTextBox.Text.Trim();

            string authors =
                authorsTextBox.Text.Trim();

            string copyright =
                copyrightTextBox.Text.Trim();

            string subjectCourse =
                subjectCourseTextBox.Text.Trim();

            string materialType =
                materialTypeComboBox.SelectedItem?
                    .ToString() ?? "Book";

            string availableAt =
                availableAtTextBox.Text.Trim();

            string reason =
                reasonTextBox.Text.Trim();

            int quantity =
                Convert.ToInt32(
                    quantityNumeric.Value);

            // =====================================================
            // VALIDATION
            // =====================================================

            if (string.IsNullOrWhiteSpace(bookTitle))
            {
                MessageBox.Show(
                    "Please enter the book title.",
                    "Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                bookTitleTextBox.Focus();

                return;
            }

            if (string.IsNullOrWhiteSpace(authors))
            {
                MessageBox.Show(
                    "Please enter the author(s).",
                    "Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                authorsTextBox.Focus();

                return;
            }

            if (string.IsNullOrWhiteSpace(
                subjectCourse))
            {
                MessageBox.Show(
                    "Please enter the subject or course code.",
                    "Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                subjectCourseTextBox.Focus();

                return;
            }

            if (string.IsNullOrWhiteSpace(reason))
            {
                MessageBox.Show(
                    "Please enter the reason for the request.",
                    "Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                reasonTextBox.Focus();

                return;
            }

            // =====================================================
            // CONFIRM
            // =====================================================

            DialogResult confirmation =
                MessageBox.Show(
                    "Submit this book request?\n\n" +
                    $"Book: {bookTitle}\n" +
                    $"Author(s): {authors}\n" +
                    $"Quantity: {quantity}\n" +
                    $"Material Type: {materialType}",
                    "Confirm Request",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question);

            if (confirmation != DialogResult.Yes)
            {
                return;
            }

            try
            {
                using MySqlConnection connection =
                    Database.GetConnection();

                connection.Open();

                // -------------------------------------------------
                // Get the internal user_id from the RFID user's ID.
                // -------------------------------------------------

                string userQuery = @"
                    SELECT user_id
                    FROM library_users
                    WHERE student_faculty_id =
                        @borrowerId
                    LIMIT 1;";

                int userId;

                using (
                    MySqlCommand userCommand =
                        new MySqlCommand(
                            userQuery,
                            connection))
                {
                    userCommand.Parameters.AddWithValue(
                        "@borrowerId",
                        borrowerId);

                    object? result =
                        userCommand.ExecuteScalar();

                    if (result == null)
                    {
                        MessageBox.Show(
                            "The current user could not be found.",
                            "User Not Found",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Error);

                        return;
                    }

                    userId =
                        Convert.ToInt32(result);
                }

                // -------------------------------------------------
                // Insert request.
                // -------------------------------------------------

                string requestQuery = @"
                    INSERT INTO book_requests
                    (
                        requested_by,
                        book_title,
                        authors,
                        copyright_year,
                        quantity,
                        subject_course_code,
                        material_type,
                        available_at,
                        reason,
                        request_date,
                        status
                    )
                    VALUES
                    (
                        @requestedBy,
                        @bookTitle,
                        @authors,
                        @copyrightYear,
                        @quantity,
                        @subjectCourse,
                        @materialType,
                        @availableAt,
                        @reason,
                        CURRENT_TIMESTAMP,
                        'PENDING'
                    );";

                using MySqlCommand requestCommand =
                    new MySqlCommand(
                        requestQuery,
                        connection);

                requestCommand.Parameters.AddWithValue(
                    "@requestedBy",
                    userId);

                requestCommand.Parameters.AddWithValue(
                    "@bookTitle",
                    bookTitle);

                requestCommand.Parameters.AddWithValue(
                    "@authors",
                    authors);

                // The database field is an integer.
                if (int.TryParse(
                    copyright,
                    out int copyrightYear))
                {
                    requestCommand.Parameters.AddWithValue(
                        "@copyrightYear",
                        copyrightYear);
                }
                else
                {
                    requestCommand.Parameters.AddWithValue(
                        "@copyrightYear",
                        DBNull.Value);
                }

                requestCommand.Parameters.AddWithValue(
                    "@quantity",
                    quantity);

                requestCommand.Parameters.AddWithValue(
                    "@subjectCourse",
                    subjectCourse);

                requestCommand.Parameters.AddWithValue(
                    "@materialType",
                    materialType);

                requestCommand.Parameters.AddWithValue(
                    "@availableAt",
                    string.IsNullOrWhiteSpace(
                        availableAt)
                        ? DBNull.Value
                        : availableAt);

                requestCommand.Parameters.AddWithValue(
                    "@reason",
                    reason);

                requestCommand.ExecuteNonQuery();

                MessageBox.Show(
                    "Book request submitted successfully!\n\n" +
                    "Status: PENDING",
                    "Request Submitted",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information);

                ClearFields();
            }
            catch (MySqlException ex)
            {
                MessageBox.Show(
                    "Database error while submitting the request.\n\n" +
                    ex.Message,
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "An unexpected error occurred.\n\n" +
                    ex.Message,
                    "Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

