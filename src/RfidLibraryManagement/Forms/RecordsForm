        // =========================================================
        // CREATE DATA GRID
        // =========================================================

        private DataGridView CreateGrid()
        {
            DataGridView grid = new DataGridView
            {
                Dock = DockStyle.Fill,
                AutoSizeColumnsMode =
                    DataGridViewAutoSizeColumnsMode.DisplayedCells,
                AllowUserToAddRows = false,
                AllowUserToDeleteRows = false,
                ReadOnly = true,
                SelectionMode =
                    DataGridViewSelectionMode.FullRowSelect,
                MultiSelect = false,
                AutoGenerateColumns = true
            };

            return grid;
        }

        // =========================================================
        // LOAD DATA
        // =========================================================

        private void LoadDataButton_Click(
            object? sender,
            EventArgs e)
        {
            try
            {
                LoadAttendance();
                LoadBorrowedBooks();
                LoadReturnedBooks();
                LoadInventory();
                LoadBookRequests();

                MessageBox.Show(
                    "Records loaded successfully.",
                    "Load Data",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information);
            }
            catch (MySqlException ex)
            {
                MessageBox.Show(
                    "Database error:\n\n" +
                    ex.Message,
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "An unexpected error occurred:\n\n" +
                    ex.Message,
                    "Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

        // =========================================================
        // ATTENDANCE
        // =========================================================

        private void LoadAttendance()
        {
            string query = @"
                SELECT
                    a.attendance_id,
                    lu.student_faculty_id AS borrower_id,
                    CONCAT(
                        lu.first_name,
                        ' ',
                        lu.middle_name,
                        ' ',
                        lu.last_name
                    ) AS name,
                    lu.user_type,
                    lu.department,
                    lu.course,
                    a.attendance_date,
                    a.time_in,
                    a.time_out,
                    a.purpose
                FROM attendance a
                INNER JOIN library_users lu
                    ON a.user_id = lu.user_id
                ORDER BY
                    a.attendance_date DESC,
                    a.time_in DESC;";

            attendanceGrid.DataSource =
                ExecuteQuery(query);
        }

        // =========================================================
        // BORROWED BOOKS
        // =========================================================

        private void LoadBorrowedBooks()
        {
            string query = @"
                SELECT
                    bt.borrow_id,
                    lu.student_faculty_id AS borrower_id,
                    CONCAT(
                        lu.first_name,
                        ' ',
                        lu.middle_name,
                        ' ',
                        lu.last_name
                    ) AS borrower_name,
                    lu.department,
                    lu.course,
                    b.accession_number,
                    b.call_number,
                    b.title AS book_title,
                    b.author,
                    bt.issued_date,
                    bt.due_date,
                    bt.status,
                    bt.remarks
                FROM borrow_transactions bt
                INNER JOIN library_users lu
                    ON bt.user_id = lu.user_id
                INNER JOIN books b
                    ON bt.book_id = b.book_id
                WHERE bt.status IN
                    ('BORROWED', 'OVERDUE')
                ORDER BY
                    bt.due_date ASC;";

            borrowedGrid.DataSource =
                ExecuteQuery(query);
        }

        // =========================================================
        // RETURNED BOOKS
        // =========================================================

        private void LoadReturnedBooks()
        {
            string query = @"
                SELECT
                    rt.return_id,
                    lu.student_faculty_id AS borrower_id,
                    CONCAT(
                        lu.first_name,
                        ' ',
                        lu.middle_name,
                        ' ',
                        lu.last_name
                    ) AS borrower_name,
                    b.accession_number,
                    b.call_number,
                    b.title AS book_title,
                    b.author,
                    bt.issued_date,
                    bt.due_date,
                    rt.returned_date,
                    rt.days_overdue,
                    rt.fine_amount,
                    rt.remarks
                FROM return_transactions rt
                INNER JOIN borrow_transactions bt
                    ON rt.borrow_id = bt.borrow_id
                INNER JOIN library_users lu
                    ON bt.user_id = lu.user_id
                INNER JOIN books b
                    ON bt.book_id = b.book_id
                ORDER BY
                    rt.returned_date DESC;";

            returnedGrid.DataSource =
                ExecuteQuery(query);
        }

        // =========================================================
        // INVENTORY
        // =========================================================

        private void LoadInventory()
        {
            string query = @"
                SELECT
                    i.inventory_id,
                    b.accession_number,
                    b.call_number,
                    b.title AS book_title,
                    b.author,
                    b.category,
                    b.location,
                    b.shelf_number,
                    b.copies,
                    b.available_copies,
                    i.inventory_date,
                    i.quantity_checked,
                    i.quantity_missing,
                    i.quantity_damaged,
                    i.remarks
                FROM inventory i
                INNER JOIN books b
                    ON i.book_id = b.book_id
                ORDER BY
                    i.inventory_date DESC;";

            inventoryGrid.DataSource =
                ExecuteQuery(query);
        }

        // =========================================================
        // BOOK REQUESTS
        // =========================================================

        private void LoadBookRequests()
        {
            string query = @"
                SELECT
                    br.request_id,
                    lu.student_faculty_id AS requested_by_id,
                    CONCAT(
                        lu.first_name,
                        ' ',
                        lu.middle_name,
                        ' ',
                        lu.last_name
                    ) AS requested_by,
                    br.book_title,
                    br.authors,
                    br.copyright_year,
                    br.quantity,
                    br.subject_course_code,
                    br.material_type,
                    br.available_at,
                    br.reason,
                    br.request_date,
                    br.status,
                    br.remarks
                FROM book_requests br
                INNER JOIN library_users lu
                    ON br.requested_by = lu.user_id
                ORDER BY
                    br.request_date DESC;";

            requestGrid.DataSource =
                ExecuteQuery(query);
        }

        // =========================================================
        // EXECUTE QUERY
        // =========================================================

        private DataTable ExecuteQuery(
            string query)
        {
            DataTable table = new DataTable();

            using MySqlConnection connection =
                Database.GetConnection();

            connection.Open();

            using MySqlCommand command =
                new MySqlCommand(
                    query,
                    connection);

            using MySqlDataAdapter adapter =
                new MySqlDataAdapter(command);

            adapter.Fill(table);

            return table;
        }

