using System;
using System.Drawing;
using System.Windows.Forms;

namespace RfidLibraryManagement.Forms
{
    public class UserDashboardForm : Form
    {
        private readonly string borrowerId;
        private readonly string borrowerName;

        private Label welcomeLabel = null!;

        private Button searchButton = null!;
        private Button borrowedBooksButton = null!;
        private Button returnedBooksButton = null!;
        private Button bookRequestButton = null!;
        private Button attendanceButton = null!;
        private Button logoutButton = null!;

        public UserDashboardForm(
            string borrowerId,
            string borrowerName)
        {
            this.borrowerId = borrowerId;
            this.borrowerName = borrowerName;

            InitializeForm();
        }

        private void InitializeForm()
        {
            Text =
                "RFID Library - User Menu";

            StartPosition =
                FormStartPosition.CenterScreen;

            Size =
                new Size(700, 600);

            FormBorderStyle =
                FormBorderStyle.FixedDialog;

            MaximizeBox = false;

            // =====================================================
            // TITLE
            // =====================================================

            Label titleLabel = new Label
            {
                Text =
                    "RFID LIBRARY MANAGEMENT SYSTEM",

                AutoSize = true,

                Font = new Font(
                    "Segoe UI",
                    20,
                    FontStyle.Bold),

                Location =
                    new Point(125, 35)
            };

            // =====================================================
            // WELCOME
            // =====================================================

            welcomeLabel = new Label
            {
                Text =
                    $"Welcome, {borrowerName}",

                AutoSize = true,

                Font = new Font(
                    "Segoe UI",
                    13,
                    FontStyle.Bold),

                Location =
                    new Point(255, 85)
            };

            // =====================================================
            // BORROWER ID
            // =====================================================

            Label borrowerIdLabel = new Label
            {
                Text =
                    $"ID Number: {borrowerId}",

                AutoSize = true,

                Font = new Font(
                    "Segoe UI",
                    10),

                Location =
                    new Point(275, 115)
            };

            // =====================================================
            // SEARCH BOOKS
            // =====================================================

            searchButton = new Button
            {
                Text = "SEARCH BOOKS",

                Location =
                    new Point(75, 165),

                Size =
                    new Size(250, 55),

                Font = new Font(
                    "Segoe UI",
                    11,
                    FontStyle.Bold)
            };

            searchButton.Click +=
                SearchButton_Click;

            // =====================================================
            // BORROWED BOOKS
            // =====================================================

            borrowedBooksButton = new Button
            {
                Text = "BORROWED BOOKS",

                Location =
                    new Point(365, 165),

                Size =
                    new Size(250, 55),

                Font = new Font(
                    "Segoe UI",
                    11,
                    FontStyle.Bold)
            };

            borrowedBooksButton.Click +=
                BorrowedBooksButton_Click;

            // =====================================================
            // RETURNED BOOKS
            // =====================================================

            returnedBooksButton = new Button
            {
                Text = "RETURNED BOOKS",

                Location =
                    new Point(75, 240),

                Size =
                    new Size(250, 55),

                Font = new Font(
                    "Segoe UI",
                    11,
                    FontStyle.Bold)
            };

            returnedBooksButton.Click +=
                ReturnedBooksButton_Click;

            // =====================================================
            // BOOK REQUEST
            // =====================================================

            bookRequestButton = new Button
            {
                Text = "BOOK REQUEST",

                Location =
                    new Point(365, 240),

                Size =
                    new Size(250, 55),

                Font = new Font(
                    "Segoe UI",
                    11,
                    FontStyle.Bold)
            };

            bookRequestButton.Click +=
                BookRequestButton_Click;

            // =====================================================
            // ATTENDANCE
            // =====================================================

            attendanceButton = new Button
            {
                Text = "ATTENDANCE",

                Location =
                    new Point(75, 315),

                Size =
                    new Size(250, 55),

                Font = new Font(
                    "Segoe UI",
                    11,
                    FontStyle.Bold)
            };

            attendanceButton.Click +=
                AttendanceButton_Click;

            // =====================================================
            // LOGOUT
            // =====================================================

            logoutButton = new Button
            {
                Text = "LOGOUT",

                Location =
                    new Point(365, 315),

                Size =
                    new Size(250, 55),

                Font = new Font(
                    "Segoe UI",
                    11,
                    FontStyle.Bold)
            };

            logoutButton.Click +=
                LogoutButton_Click;

            // =====================================================
            // ADD CONTROLS
            // =====================================================

            Controls.Add(titleLabel);
            Controls.Add(welcomeLabel);
            Controls.Add(borrowerIdLabel);

            Controls.Add(searchButton);
            Controls.Add(borrowedBooksButton);
            Controls.Add(returnedBooksButton);
            Controls.Add(bookRequestButton);
            Controls.Add(attendanceButton);
            Controls.Add(logoutButton);
        }

        // =========================================================
        // SEARCH BOOKS
        // =========================================================

        private void SearchButton_Click(
            object? sender,
            EventArgs e)
        {
            using SearchForm searchForm =
                new SearchForm();

            searchForm.ShowDialog();
        }

        // =========================================================
        // BORROWED BOOKS
        // =========================================================

        private void BorrowedBooksButton_Click(
            object? sender,
            EventArgs e)
        {
            using UserBorrowedBooksForm form =
                new UserBorrowedBooksForm(
                    borrowerId);

            form.ShowDialog();
        }

        // =========================================================
        // RETURNED BOOKS
        // =========================================================

        private void ReturnedBooksButton_Click(
            object? sender,
            EventArgs e)
        {
            using UserReturnedBooksForm form =
                new UserReturnedBooksForm(
                    borrowerId);

            form.ShowDialog();
        }

        // =========================================================
        // BOOK REQUEST
        // =========================================================

        private void BookRequestButton_Click(
            object? sender,
            EventArgs e)
        {
            using BookRequestForm form =
                new BookRequestForm(
                    borrowerId,
                    borrowerName);

            form.ShowDialog();
        }

        // =========================================================
        // ATTENDANCE
        // =========================================================

    private void AttendanceButton_Click(
    object? sender,
    EventArgs e)
{
    using AttendanceForm form =
        new AttendanceForm(borrowerId);

    form.ShowDialog();
}

        // =========================================================
        // LOGOUT
        // =========================================================

        private void LogoutButton_Click(
            object? sender,
            EventArgs e)
        {
            DialogResult result =
                MessageBox.Show(
                    "Are you sure you want to logout?",
                    "Confirm Logout",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question);

            if (result == DialogResult.Yes)
            {
                Close();
            }
        }
    }
}
