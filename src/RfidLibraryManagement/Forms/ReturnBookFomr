        private void FindButton_Click(object? sender, EventArgs e)
        {
            string accessionNumber =
                accessionNumberTextBox.Text.Trim();

            if (string.IsNullOrWhiteSpace(accessionNumber))
            {
                MessageBox.Show(
                    "Please enter the accession number.",
                    "Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                accessionNumberTextBox.Focus();
                return;
            }

            try
            {
                using MySqlConnection connection =
                    Database.GetConnection();

                connection.Open();

                string query = @"
                    SELECT
                        bt.borrow_id,
                        b.book_id,
                        b.title,
                        lu.student_faculty_id,
                        CONCAT(
                            lu.first_name,
                            ' ',
                            lu.middle_name,
                            ' ',
                            lu.last_name
                        ) AS borrower_name,
                        bt.issued_date,
                        bt.due_date
                    FROM borrow_transactions bt
                    INNER JOIN books b
                        ON bt.book_id = b.book_id
                    INNER JOIN library_users lu
                        ON bt.user_id = lu.user_id
                    WHERE b.accession_number = @accession
                      AND bt.status = 'BORROWED'
                    ORDER BY bt.issued_date DESC
                    LIMIT 1;";

                using MySqlCommand command =
                    new MySqlCommand(query, connection);

                command.Parameters.AddWithValue(
                    "@accession",
                    accessionNumber);

                using MySqlDataReader reader =
                    command.ExecuteReader();

                if (reader.Read())
                {
                    borrowId = Convert.ToInt32(
                        reader["borrow_id"]);

                    bookId = Convert.ToInt32(
                        reader["book_id"]);

                    borrowerIdTextBox.Text =
                        reader["student_faculty_id"].ToString();

                    borrowerNameTextBox.Text =
                        reader["borrower_name"].ToString();

                    bookTitleTextBox.Text =
                        reader["title"].ToString();

                    DateTime issueDate =
                        Convert.ToDateTime(reader["issued_date"]);

                    DateTime dueDate =
                        Convert.ToDateTime(reader["due_date"]);

                    issueDateTextBox.Text =
                        issueDate.ToShortDateString();

                    dueDateTextBox.Text =
                        dueDate.ToShortDateString();

                    CalculateFine();

                    MessageBox.Show(
                        "Borrowed book record found.",
                        "Record Found",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information);
                }
                else
                {
                    MessageBox.Show(
                        "No active borrowed transaction was found for this accession number.",
                        "Not Found",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information);

                    ClearFields();
                }
            }
            catch (MySqlException ex)
            {
                MessageBox.Show(
                    "Database error:\n\n" + ex.Message,
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "An unexpected error occurred:\n\n" +
                    ex.Message,
                    "Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

