        private void CalculateFine()
        {
            if (string.IsNullOrWhiteSpace(
                dueDateTextBox.Text))
            {
                daysOverdueTextBox.Text = "0";
                fineTextBox.Text = "₱0.00";
                return;
            }

            if (!DateTime.TryParse(
                dueDateTextBox.Text,
                out DateTime dueDate))
            {
                return;
            }

            DateTime returnDate =
                returnDatePicker.Value.Date;

            int daysOverdue =
                (returnDate - dueDate.Date).Days;

            if (daysOverdue < 0)
            {
                daysOverdue = 0;
            }

            decimal fine =
                daysOverdue * FinePerDay;

            daysOverdueTextBox.Text =
                daysOverdue.ToString();

            fineTextBox.Text =
                $"₱{fine:N2}";
        }

        private void ReturnButton_Click(
            object? sender,
            EventArgs e)
        {
            if (borrowId <= 0 || bookId <= 0)
            {
                MessageBox.Show(
                    "Please find a valid borrowed book first.",
                    "Return Book",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                return;
            }

            CalculateFine();

            if (!DateTime.TryParse(
                dueDateTextBox.Text,
                out DateTime dueDate))
            {
                MessageBox.Show(
                    "Invalid due date.",
                    "Return Book",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);

                return;
            }

            DateTime returnDate =
                returnDatePicker.Value.Date;

            if (returnDate < dueDate.Date)
            {
                DialogResult result = MessageBox.Show(
                    "The return date is earlier than the due date.\n\n" +
                    "Do you want to continue?",
                    "Confirm Return Date",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Question);

                if (result != DialogResult.Yes)
                {
                    return;
                }
            }

            int daysOverdue =
                Math.Max(
                    0,
                    (returnDate - dueDate.Date).Days);

            decimal fine =
                daysOverdue * FinePerDay;

            try
            {
                using MySqlConnection connection =
                    Database.GetConnection();

                connection.Open();

                using MySqlTransaction transaction =
                    connection.BeginTransaction();

                // Verify the transaction is still active.
                string checkQuery = @"
                    SELECT status
                    FROM borrow_transactions
                    WHERE borrow_id = @borrowId
                    FOR UPDATE;";

                using MySqlCommand checkCommand =
                    new MySqlCommand(
                        checkQuery,
                        connection,
                        transaction);

                checkCommand.Parameters.AddWithValue(
                    "@borrowId",
                    borrowId);

                object? statusResult =
                    checkCommand.ExecuteScalar();

                if (statusResult == null ||
                    statusResult.ToString() != "BORROWED")
                {
                    transaction.Rollback();

                    MessageBox.Show(
                        "This transaction has already been returned or is no longer active.",
                        "Return Book",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning);

                    ClearFields();
                    return;
                }

                // Record the return transaction.
                string returnQuery = @"
                    INSERT INTO return_transactions
                    (
                        borrow_id,
                        returned_date,
                        days_overdue,
                        fine_amount,
                        remarks
                    )
                    VALUES
                    (
                        @borrowId,
                        @returnedDate,
                        @daysOverdue,
                        @fineAmount,
                        @remarks
                    );";

                using MySqlCommand returnCommand =
                    new MySqlCommand(
                        returnQuery,
                        connection,
                        transaction);

                returnCommand.Parameters.AddWithValue(
                    "@borrowId",
                    borrowId);

                returnCommand.Parameters.AddWithValue(
                    "@returnedDate",
                    returnDate);

                returnCommand.Parameters.AddWithValue(
                    "@daysOverdue",
                    daysOverdue);

                returnCommand.Parameters.AddWithValue(
                    "@fineAmount",
                    fine);

                returnCommand.Parameters.AddWithValue(
                    "@remarks",
                    remarksTextBox.Text.Trim());

                returnCommand.ExecuteNonQuery();

                // Mark borrowing transaction as returned.
                string updateBorrowQuery = @"
                    UPDATE borrow_transactions
                    SET
                        status = 'RETURNED',
                        updated_at = CURRENT_TIMESTAMP
                    WHERE borrow_id = @borrowId;";

                using MySqlCommand updateBorrowCommand =
                    new MySqlCommand(
                        updateBorrowQuery,
                        connection,
                        transaction);

                updateBorrowCommand.Parameters.AddWithValue(
                    "@borrowId",
                    borrowId);

                updateBorrowCommand.ExecuteNonQuery();

                // Increase available copies.
                string updateBookQuery = @"
                    UPDATE books
                    SET
                        available_copies =
                            LEAST(
                                copies,
                                available_copies + 1
                            ),
                        status = 'AVAILABLE',
                        updated_at = CURRENT_TIMESTAMP
                    WHERE book_id = @bookId;";

                using MySqlCommand updateBookCommand =
                    new MySqlCommand(
                        updateBookQuery,
                        connection,
                        transaction);

                updateBookCommand.Parameters.AddWithValue(
                    "@bookId",
                    bookId);

                updateBookCommand.ExecuteNonQuery();

                transaction.Commit();

                MessageBox.Show(
                    "Book returned successfully!\n\n" +
                    $"Days Overdue: {daysOverdue}\n" +
                    $"Fine: ₱{fine:N2}",
                    "Return Successful",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information);

                ClearFields();
            }
            catch (MySqlException ex)
            {
                MessageBox.Show(
                    "Database error while processing the return:\n\n" +
                    ex.Message,
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "An unexpected error occurred:\n\n" +
                    ex.Message,
                    "Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

