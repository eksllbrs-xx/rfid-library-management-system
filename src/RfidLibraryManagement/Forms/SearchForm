        private void SearchTextBox_KeyDown(
            object? sender,
            KeyEventArgs e)
        {
            if (e.KeyCode == Keys.Enter)
            {
                SearchBooks();
                e.SuppressKeyPress = true;
            }
        }

        private void SearchButton_Click(
            object? sender,
            EventArgs e)
        {
            SearchBooks();
        }

        private void SearchBooks()
        {
            string searchText =
                searchTextBox.Text.Trim();

            if (string.IsNullOrWhiteSpace(searchText))
            {
                MessageBox.Show(
                    "Please enter a search value.",
                    "Search",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                searchTextBox.Focus();
                return;
            }

            string selectedType =
                searchTypeComboBox.SelectedItem?
                    .ToString() ?? "Book Title";

            string column;

            switch (selectedType)
            {
                case "Book Title":
                    column = "b.title";
                    break;

                case "Author":
                    column = "b.author";
                    break;

                case "Accession Number":
                    column = "b.accession_number";
                    break;

                case "Call Number":
                    column = "b.call_number";
                    break;

                case "ISBN":
                    column = "b.isbn";
                    break;

                case "Category":
                    column = "b.category";
                    break;

                case "Borrower ID":
                    SearchBorrowers(
                        "lu.student_faculty_id",
                        searchText);
                    return;

                case "Borrower Name":
                    SearchBorrowersByName(searchText);
                    return;

                default:
                    column = "b.title";
                    break;
            }

            try
            {
                string query = $@"
                    SELECT
                        b.book_id,
                        b.accession_number,
                        b.call_number,
                        b.isbn,
                        b.title,
                        b.author,
                        b.edition,
                        b.category,
                        b.nature_of_content,
                        b.location,
                        b.shelf_number,
                        b.copies,
                        b.available_copies,
                        b.price,
                        b.date_registered,
                        b.status
                    FROM books b
                    WHERE {column} LIKE @search
                    ORDER BY b.title ASC;";

                resultsGrid.DataSource =
                    ExecuteQuery(
                        query,
                        "@search",
                        "%" + searchText + "%");

                if (resultsGrid.Rows.Count == 0)
                {
                    MessageBox.Show(
                        "No matching records found.",
                        "Search",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information);
                }
            }
            catch (MySqlException ex)
            {
                MessageBox.Show(
                    "Database error:\n\n" +
                    ex.Message,
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "An unexpected error occurred:\n\n" +
                    ex.Message,
                    "Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

        private void SearchBorrowers(
            string column,
            string searchText)
        {
            try
            {
                string query = $@"
                    SELECT
                        lu.user_id,
                        lu.student_faculty_id,
                        lu.rfid_uid,
                        CONCAT(
                            lu.first_name,
                            ' ',
                            lu.middle_name,
                            ' ',
                            lu.last_name
                        ) AS full_name,
                        lu.user_type,
                        lu.department,
                        lu.course,
                        lu.email,
                        lu.contact_number,
                        lu.status
                    FROM library_users lu
                    WHERE {column} LIKE @search
                    ORDER BY
                        lu.last_name,
                        lu.first_name;";

                resultsGrid.DataSource =
                    ExecuteQuery(
                        query,
                        "@search",
                        "%" + searchText + "%");
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Unable to search borrowers.\n\n" +
                    ex.Message,
                    "Search Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

        private void SearchBorrowersByName(
            string searchText)
        {
            try
            {
                string query = @"
                    SELECT
                        lu.user_id,
                        lu.student_faculty_id,
                        lu.rfid_uid,
                        CONCAT(
                            lu.first_name,
                            ' ',
                            lu.middle_name,
                            ' ',
                            lu.last_name
                        ) AS full_name,
                        lu.user_type,
                        lu.department,
                        lu.course,
                        lu.email,
                        lu.contact_number,
                        lu.status
                    FROM library_users lu
                    WHERE CONCAT(
                        lu.first_name,
                        ' ',
                        lu.middle_name,
                        ' ',
                        lu.last_name
                    ) LIKE @search
                    ORDER BY
                        lu.last_name,
                        lu.first_name;";

                resultsGrid.DataSource =
                    ExecuteQuery(
                        query,
                        "@search",
                        "%" + searchText + "%");
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Unable to search borrowers.\n\n" +
                    ex.Message,
                    "Search Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }

        private DataTable ExecuteQuery(
            string query,
            string parameterName,
            string parameterValue)
        {
            DataTable table = new DataTable();

            using MySqlConnection connection =
                Database.GetConnection();

            connection.Open();

            using MySqlCommand command =
                new MySqlCommand(
                    query,
                    connection);

            command.Parameters.AddWithValue(
                parameterName,
                parameterValue);

            using MySqlDataAdapter adapter =
                new MySqlDataAdapter(command);

            adapter.Fill(table);

            return table;
        }

        private void ClearButton_Click(
            object? sender,
            EventArgs e)
        {
            searchTextBox.Clear();
            resultsGrid.DataSource = null;
            searchTypeComboBox.SelectedIndex = 0;
            searchTextBox.Focus();
        }

        private void CloseButton_Click(
            object? sender,
            EventArgs e)
        {
            Close();
        }
    }
