            };

            searchTypeComboBox.Items.AddRange(
                new object[]
                {
                    "Book Title",
                    "Author",
                    "Accession Number",
                    "Call Number",
                    "ISBN",
                    "Category",
                    "Borrower ID",
                    "Borrower Name"
                });

            searchTypeComboBox.SelectedIndex = 0;

            searchTextBox = new TextBox
