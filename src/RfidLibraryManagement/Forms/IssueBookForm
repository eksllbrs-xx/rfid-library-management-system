        // ==========================================
        // FIND BORROWER
        // ==========================================

        private void FindBorrowerButton_Click(
            object? sender,
            EventArgs e)
        {
            string borrowerId =
                borrowerIdTextBox.Text.Trim();


            if (string.IsNullOrWhiteSpace(
                borrowerId))
            {
                MessageBox.Show(
                    "Please enter the student/faculty ID number.",
                    "Borrower Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                borrowerIdTextBox.Focus();

                return;
            }


            try
            {
                using MySqlConnection connection =
                    Database.GetConnection();

                connection.Open();


                string query = @"
                    SELECT
                        student_faculty_id,
                        first_name,
                        middle_name,
                        last_name,
                        department,
                        course
                    FROM library_users
                    WHERE student_faculty_id =
                        @borrowerId
                    AND status = 'ACTIVE'
                    LIMIT 1;";


                using MySqlCommand command =
                    new MySqlCommand(
                        query,
                        connection);


                command.Parameters.AddWithValue(
                    "@borrowerId",
                    borrowerId);


                using MySqlDataReader reader =
                    command.ExecuteReader();


                if (reader.Read())
                {
                    string firstName =
                        reader["first_name"]
                            .ToString() ?? "";

                    string middleName =
                        reader["middle_name"]
                            .ToString() ?? "";

                    string lastName =
                        reader["last_name"]
                            .ToString() ?? "";


                    fullNameTextBox.Text =
                        $"{firstName} {middleName} {lastName}"
                            .Replace(
                                "  ",
                                " ")
                            .Trim();


                    departmentTextBox.Text =
                        reader["department"]
                            .ToString() ?? "";


                    courseTextBox.Text =
                        reader["course"]
                            .ToString() ?? "";
                }
                else
                {
                    ClearBorrowerFields();

                    MessageBox.Show(
                        "Borrower not found or inactive.",
                        "Borrower Not Found",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Unable to find the borrower.\n\n" +
                    $"Details: {ex.Message}",
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }


        // ==========================================
        // FIND BOOK
        // ==========================================

        private void FindBookButton_Click(
            object? sender,
            EventArgs e)
        {
            string accessionNumber =
                accessionNumberTextBox.Text.Trim();


            if (string.IsNullOrWhiteSpace(
                accessionNumber))
            {
                MessageBox.Show(
                    "Please enter the accession number.",
                    "Book Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                accessionNumberTextBox.Focus();

                return;
            }


            try
            {
                using MySqlConnection connection =
                    Database.GetConnection();

                connection.Open();


                string query = @"
                    SELECT
                        accession_number,
                        call_number,
                        title,
                        author,
                        available_copies
                    FROM books
                    WHERE accession_number =
                        @accessionNumber
                    LIMIT 1;";


                using MySqlCommand command =
                    new MySqlCommand(
                        query,
                        connection);


                command.Parameters.AddWithValue(
                    "@accessionNumber",
                    accessionNumber);


                using MySqlDataReader reader =
                    command.ExecuteReader();


                if (reader.Read())
                {
                    callNumberTextBox.Text =
                        reader["call_number"]
                            .ToString() ?? "";


                    bookTitleTextBox.Text =
                        reader["title"]
                            .ToString() ?? "";


                    authorTextBox.Text =
                        reader["author"]
                            .ToString() ?? "";


                    copiesTextBox.Text =
                        reader["available_copies"]
                            .ToString() ?? "0";
                }
                else
                {
                    ClearBookFields();

                    MessageBox.Show(
                        "Book not found.",
                        "Book Not Found",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Unable to find the book.\n\n" +
                    $"Details: {ex.Message}",
                    "Database Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }


        // ==========================================
        // ISSUE BOOK
        // ==========================================

        private void IssueBookButton_Click(
            object? sender,
            EventArgs e)
        {
            string borrowerId =
                borrowerIdTextBox.Text.Trim();

            string accessionNumber =
                accessionNumberTextBox.Text.Trim();


            // ------------------------------------------
            // VALIDATE BORROWER
            // ------------------------------------------

            if (string.IsNullOrWhiteSpace(
                borrowerId) ||
                string.IsNullOrWhiteSpace(
                    fullNameTextBox.Text))
            {
                MessageBox.Show(
                    "Please find and select a valid borrower.",
                    "Borrower Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                return;
            }


            // ------------------------------------------
            // VALIDATE BOOK
            // ------------------------------------------

            if (string.IsNullOrWhiteSpace(
                accessionNumber) ||
                string.IsNullOrWhiteSpace(
                    bookTitleTextBox.Text))
            {
                MessageBox.Show(
                    "Please find a valid book.",
                    "Book Required",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                return;
            }


            // ------------------------------------------
            // VALIDATE DATES
            // ------------------------------------------

            if (dueDatePicker.Value.Date <
                issueDatePicker.Value.Date)
            {
                MessageBox.Show(
                    "Due Date cannot be earlier than Issue Date.",
                    "Invalid Date",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);

                return;
            }


            try
            {
                using MySqlConnection connection =
                    Database.GetConnection();

                connection.Open();


                using MySqlTransaction transaction =
                    connection.BeginTransaction();


                try
                {
                    // ==========================================
                    // GET BORROWER ID
                    // ==========================================

                    string borrowerQuery = @"
                        SELECT user_id
                        FROM library_users
                        WHERE student_faculty_id =
                            @borrowerId
                        AND status = 'ACTIVE'
                        LIMIT 1;";


                    int userId;


                    using (
                        MySqlCommand borrowerCommand =
                            new MySqlCommand(
                                borrowerQuery,
                                connection,
                                transaction))
                    {
                        borrowerCommand.Parameters.AddWithValue(
                            "@borrowerId",
                            borrowerId);


                        object? result =
                            borrowerCommand.ExecuteScalar();


                        if (result == null)
                        {
                            throw new Exception(
                                "Borrower could not be found.");
                        }


                        userId =
                            Convert.ToInt32(result);
                    }


                    // ==========================================
                    // GET BOOK ID AND AVAILABLE COPIES
                    // ==========================================

                    string bookQuery = @"
                        SELECT
                            book_id,
                            available_copies
                        FROM books
                        WHERE accession_number =
                            @accessionNumber
                        FOR UPDATE;";


                    int bookId;
                    int availableCopies;


                    using (
                        MySqlCommand bookCommand =
                            new MySqlCommand(
                                bookQuery,
                                connection,
                                transaction))
                    {
                        bookCommand.Parameters.AddWithValue(
                            "@accessionNumber",
                            accessionNumber);


                        using MySqlDataReader reader =
                            bookCommand.ExecuteReader();


                        if (!reader.Read())
                        {
                            reader.Close();

                            throw new Exception(
                                "Book could not be found.");
                        }


                        bookId =
                            Convert.ToInt32(
                                reader["book_id"]);


                        availableCopies =
                            Convert.ToInt32(
                                reader["available_copies"]);


                        reader.Close();
                    }


                    // ==========================================
                    // CHECK AVAILABLE COPIES
                    // ==========================================

                    if (availableCopies <= 0)
                    {
                        throw new Exception(
                            "No available copies of this book.");
                    }


                    // ==========================================
                    // INSERT BORROW TRANSACTION
                    // ==========================================

                    string insertQuery = @"
                        INSERT INTO borrow_transactions
                        (
                            user_id,
                            book_id,
                            issued_date,
                            due_date,
                            status,
                            remarks
                        )
                        VALUES
                        (
                            @userId,
                            @bookId,
                            @issuedDate,
                            @dueDate,
                            'BORROWED',
                            @remarks
                        );";


                    using (
                        MySqlCommand insertCommand =
                            new MySqlCommand(
                                insertQuery,
                                connection,
                                transaction))
                    {
                        insertCommand.Parameters.AddWithValue(
                            "@userId",
                            userId);


                        insertCommand.Parameters.AddWithValue(
                            "@bookId",
                            bookId);


                        insertCommand.Parameters.AddWithValue(
                            "@issuedDate",
                            issueDatePicker.Value.Date);


                        insertCommand.Parameters.AddWithValue(
                            "@dueDate",
                            dueDatePicker.Value.Date);


                        insertCommand.Parameters.AddWithValue(
                            "@remarks",
                            remarksTextBox.Text.Trim());


                        insertCommand.ExecuteNonQuery();
                    }


                    // ==========================================
                    // DECREASE AVAILABLE COPIES
                    // ==========================================

                    string updateBookQuery = @"
                        UPDATE books
                        SET
                            available_copies =
                                available_copies - 1,
                            status =
                                CASE
                                    WHEN available_copies - 1 <= 0
                                    THEN 'BORROWED'
                                    ELSE 'AVAILABLE'
                                END
                        WHERE book_id = @bookId
                        AND available_copies > 0;";


                    using (
                        MySqlCommand updateCommand =
                            new MySqlCommand(
                                updateBookQuery,
                                connection,
                                transaction))
                    {
                        updateCommand.Parameters.AddWithValue(
                            "@bookId",
                            bookId);


                        int affectedRows =
                            updateCommand.ExecuteNonQuery();


                        if (affectedRows == 0)
                        {
                            throw new Exception(
                                "Unable to update book availability.");
                        }
                    }


                    // ==========================================
                    // COMMIT
                    // ==========================================

                    transaction.Commit();


                    MessageBox.Show(
                        "Book successfully issued.",
                        "Issue Book",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information);


                    ClearForm();
                }
                catch
                {
                    transaction.Rollback();

                    throw;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Unable to issue the book.\n\n" +
                    $"Details: {ex.Message}",
                    "Issue Book Error",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
            }
        }


